CONFIG_ESP32_REV_MIN_0=y
CONFIG_BLUERETRO_HW2=n
CONFIG_BLUERETRO_SYSTEM_GC=y
CONFIG_BLUERETRO_QEMU=y
CONFIG_BLUERETRO_WS_CMDS=y
CONFIG_BLUERETRO_BT_DISABLE=y
CONFIG_BLUERETRO_DUMP_HID_DESC=y
CONFIG_BLUERETRO_ADAPTER_BTNS_DBG=y
CONFIG_BLUERETRO_ADAPTER_INPUT_DBG=y
CONFIG_BLUERETRO_ADAPTER_INPUT_MAP_DBG=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_HTTPD_WS_SUPPORT=y
# The console UART drains slowly on a loaded host, so the per-report debug
# prints can outlast the default 300ms and trip the interrupt watchdog.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000
# The build-time options this fork adds that reach code QEMU runs: the N64 port's device
# identity following what is connected, and the default accessories applied to the config.
CONFIG_BLUERETRO_N64_AUTO_ID_SWITCHING=y
CONFIG_BLUERETRO_DEFAULT_ACC_RUMBLE=y
CONFIG_BLUERETRO_DEFAULT_ACC_P1_MEM=y
CONFIG_BLUERETRO_DEFAULT_ACC_APPLY_REV=1
